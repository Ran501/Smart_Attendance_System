PORT=3000
NODE_ENV=development

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

FACE_MATCH_THRESHOLD=0.70
DEFAULT_SESSION_DURATION_MINUTES=5

# Bluetooth proximity (must match Flutter AppConstants)
BLE_MAX_DISTANCE_METERS=20
BLE_MIN_RSSI=-95

CORS_ORIGIN=*

# Push notifications (required for tray alerts when app is closed)
# Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Or paste JSON for cloud hosts: FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
